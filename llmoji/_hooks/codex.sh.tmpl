#!/usr/bin/env bash
# Auto-generated by llmoji $LLMOJI_VERSION. DO NOT edit by hand —
# `llmoji install codex` regenerates this file from
# llmoji/_hooks/codex.sh.tmpl. Edits will be lost.
#
# Codex Stop hook: read-only journal logger. NEVER blocks.
# Appends one JSONL row PER kaomoji-led agent message in the current
# turn. A tool-heavy turn easily writes 5–10 agent messages (each its
# own line in the rollout JSONL); any of them can be kaomoji-led, and
# the journal captures every kaomoji-led one, not just the final
# summary.
#
# Two rollout shapes carry those messages:
#
#   * ``event_msg`` / ``payload.type == "item_completed"`` with
#     ``payload.item.type == "AgentMessage"`` (text in
#     ``item.content[].text``) — current codex-cli. The 0.16x line
#     writes only this shape.
#   * ``event_msg`` / ``payload.type == "agent_message"`` (text in
#     ``payload.message``) — older codex-cli, and the only shape the
#     pre-2.2 hook read. Against a current rollout it matched nothing,
#     so capture went silent without an error.
#
# A turn is read in whichever shape it carries: item_completed
# messages win, and the legacy events are the fallback for a turn
# with none. A release that wrote both for the same message therefore
# can't land it twice. ``response_item`` assistant messages are NOT
# read: a forked thread replays its parent's history into the new
# rollout as response_items, and walking them would journal the
# parent's messages again under the child.
#
# Schema (canonical 6-field journal row):
#   ts             ISO-8601 UTC  the message event's rollout timestamp
#                                (hook fire time if it has none)
#   model          str           active model slug (Stop payload, else
#                                the turn's turn_context)
#   cwd            str           working directory (Stop event)
#   kaomoji        str           leading non-letter prefix of an
#                                agent message, ≥2 bytes
#   user_text      str           latest real user prompt in the
#                                rollout up to this turn
#   assistant_text str           agent message MINUS the leading
#                                kaomoji + surrounding whitespace
#
# Consumed by `llmoji analyze` via llmoji.sources.journal.
set -u

INPUT=$(cat)

MODEL=$(printf '%s' "$INPUT"   | jq -r '.model           // empty' 2>/dev/null || printf '')
CWD=$(printf '%s' "$INPUT"     | jq -r '.cwd             // empty' 2>/dev/null || printf '')
ROLLOUT=$(printf '%s' "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null || printf '')

[ -z "$ROLLOUT" ] && exit 0
[ ! -f "$ROLLOUT" ] && exit 0

# Single rollout read for the turn-level facts we need:
#
#   * is_subagent — the rollout belongs to a spawned subagent thread
#     (``session_meta.payload.thread_source == "subagent"``, or a
#     ``source`` object carrying ``subagent``). Agent-to-agent
#     dispatches stay out of the corpus, as Claude Code sidechains do.
#   * start_idx — index of the latest ``turn_context`` event. That
#     event fires once at the start of every turn; the last one is
#     for THIS turn (Stop fires after the turn's task_complete).
#     The per-message walk below slices forward from this index.
#     ``// 0`` falls back to the start of the file if there's no
#     turn_context (shouldn't happen in real rollouts, but keeps the
#     walk well-defined).
#   * turn_model — the latest turn_context's ``model``, used when the
#     Stop payload carries none.
#   * user_text — latest real user response_item in the rollout so
#     far. A turn Codex starts on its own (a goal step, a subagent's
#     result) has no user message of its own and carries the prompt
#     that set it going; the backfill reads it the same way. Codex
#     injects AGENTS.md / <environment_context> / <INSTRUCTIONS> as
#     user-role response_items at session start; the prefix filter
#     drops them.
META=$(jq -cs '
  ([to_entries[] | select(.value.type == "turn_context") | .key] | last // 0) as $s
  | (map(select(.type == "session_meta")) | first | .payload // {}) as $meta
  | {
      is_subagent: (
        ($meta.thread_source // "") == "subagent"
        or ((($meta.source // null) | type) == "object"
            and ($meta.source | has("subagent")))
      ),
      start_idx: $s,
      turn_model: (map(select(.type == "turn_context")) | last | .payload.model // ""),
      user_text: (
        [ .[]
            | select(.type == "response_item" and (.payload.role // "") == "user")
            | (.payload.content
               | if type == "array"
                 then (map(select(.type == "input_text") | .text // "") | join("\n"))
                 else "" end)
            | select(. != "")
            | select($INJECTED_PREFIXES_FILTER)
        ]
        | last // ""
      )
    }
' "$ROLLOUT" 2>/dev/null)
[ -z "$META" ] && META='{}'

IS_SUBAGENT=$(printf '%s' "$META" | jq -r '.is_subagent // false')
[ "$IS_SUBAGENT" = "true" ] && exit 0
START_IDX=$(printf '%s' "$META" | jq -r '.start_idx // 0')
USER_TEXT=$(printf '%s' "$META" | jq -r '.user_text // ""')
[ -z "$MODEL" ] && MODEL=$(printf '%s' "$META" | jq -r '.turn_model // ""')

# Walk every agent message in the current turn and emit one journal
# row per kaomoji-led message. ``phase`` (``"commentary"`` for
# progress messages, ``"final_answer"`` for the closing one) isn't
# filtered on — every kaomoji-led message counts.
#
# The validate partial is rendered with ``SKIP_ACTION=continue`` so
# a non-kaomoji message skips its row without aborting the walk.
jq -cs --argjson s "$START_IDX" '
  .[$s:] as $turn
  | [ $turn[]
      | select(.type == "event_msg"
               and (.payload.type // "") == "item_completed"
               and (.payload.item.type // "") == "AgentMessage")
      | { text: ((.payload.item.content // [])
                 | map(select(((.type // "") | ascii_downcase) == "text") | .text // "")
                 | join("")),
          ts:   (.timestamp // "") }
    ] as $items
  | (if ($items | length) > 0 then $items
     else [ $turn[]
            | select(.type == "event_msg" and (.payload.type // "") == "agent_message")
            | { text: (.payload.message // ""), ts: (.timestamp // "") } ]
     end)
  | .[]
  | select(.text != "")
' "$ROLLOUT" 2>/dev/null | while IFS= read -r row; do
  [ -z "$row" ] && continue
  ASSISTANT_TEXT=$(printf '%s' "$row" | jq -r '.text')
  ROW_TS=$(printf         '%s' "$row" | jq -r '.ts')
  ${KAOMOJI_VALIDATE}
  ${JOURNAL_WRITE}
done

exit 0
