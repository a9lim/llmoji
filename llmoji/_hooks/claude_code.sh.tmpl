#!/usr/bin/env bash
# Auto-generated by llmoji $LLMOJI_VERSION. DO NOT edit by hand —
# `llmoji install claude_code` regenerates this file from
# llmoji/_hooks/claude_code.sh.tmpl. Edits will be lost.
#
# Stop hook: read-only journal logger. NEVER blocks.
# Appends one JSONL row PER kaomoji-led assistant text entry in the
# current turn. Claude Code persists each assistant content block —
# text, tool_use, thinking — as its own top-level transcript JSONL
# entry, so a tool-heavy turn (text → tool_use → text → tool_use →
# text) emits up to one row per text block. The kaomoji filter
# decides which entries actually land in the journal; non-kaomoji
# entries are skipped without bailing the rest of the walk.
#
# Schema (canonical 6-field journal row):
#   ts             ISO-8601 UTC  the entry's own transcript timestamp
#                                (hook fire time if it has none)
#   model          str           active model slug
#   cwd            str           working directory
#   kaomoji        str           leading non-letter prefix of an
#                                assistant text entry, ≥2 bytes
#   user_text      str           latest real user turn (resolved
#                                once per turn — every row from
#                                this turn shares the same prompt)
#   assistant_text str           assistant text MINUS the leading
#                                kaomoji + surrounding whitespace
#
# Consumed by `llmoji analyze` via llmoji.sources.journal.
set -u

INPUT=$(cat)

TRANSCRIPT=$(printf '%s' "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null || true)
CWD=$(printf '%s' "$INPUT"         | jq -r '.cwd             // empty' 2>/dev/null || true)
# The turn's final assistant text, straight from the Stop payload
# (Claude Code 2.1.47+). Claude Code documents that the transcript may
# not hold the final message yet when Stop fires; on a real corpus
# that race dropped roughly a quarter of all kaomoji-led messages,
# nearly always the closing one. The walk below falls back to this
# when the transcript is behind.
LAST_MSG=$(printf '%s' "$INPUT"    | jq -r '.last_assistant_message // empty' 2>/dev/null || true)

[ -z "$TRANSCRIPT" ] && exit 0
[ ! -f "$TRANSCRIPT" ] && exit 0

# Single transcript read for the three turn-level facts we need:
#
#   * is_sidechain — last assistant entry's ``isSidechain`` flag.
#     Sidechain (subagent) turns are agent-to-agent dispatches that
#     shouldn't mix with the kaomoji-vs-human-prompt corpus, so we
#     skip the whole hook fire on a sidechain turn.
#   * boundary_ts — timestamp of the latest "real" user turn (string
#     content OR text-block array that isn't a tool_result, and whose
#     text isn't a system injection). Tool-result user events are
#     machine-generated interleavings inside a turn, not turn
#     boundaries; neither is a skill body Claude Code injects as a
#     user-role message mid-turn — counting one as a boundary dropped
#     every kaomoji-led message before the skill loaded. The per-entry
#     walk below treats every assistant entry at-or-after this
#     timestamp as part of the current turn.
#   * user_text — the latest real-user message text (string OR text-
#     block-array, after the injected-prefix filter), applied to every
#     row this turn produces.
#
# Pre-fix the hook ran three separate ``jq -rs`` slurps over the same
# transcript file, paying the read cost three times. One ``-cs`` call
# emits a compact JSON blob with all three; the small extractions
# below are cheap (no file IO).
META=$(jq -cs '
  def user_text_of: .message.content as $c
    | if   ($c | type) == "string" then $c
      elif ($c | type) == "array"  then ($c | map(select(.type == "text") | .text // "") | join("\n"))
      else "" end;
  {
    is_sidechain: (map(select(.type == "assistant")) | last | (.isSidechain // false)),
    boundary_ts: (
      map(select(
        .type == "user"
        and (
          (.message.content | type) == "string"
          or (
            (.message.content | type) == "array"
            and ((.message.content | any(.type == "tool_result")) | not)
          )
        )
        and (user_text_of as $t | $t == "" or ($t | $INJECTED_PREFIXES_FILTER))
      ))
      | last
      | (.timestamp // "")
    ),
    user_text: (
      [ .[]
        | select(.type == "user")
        | user_text_of
        | select(. != "" and ($INJECTED_PREFIXES_FILTER))
      ]
      | last // ""
    )
  }
' "$TRANSCRIPT" 2>/dev/null)
[ -z "$META" ] && META='{}'

IS_SIDECHAIN=$(printf '%s' "$META" | jq -r '.is_sidechain // false')
[ "$IS_SIDECHAIN" = "true" ] && exit 0
BOUNDARY_TS=$(printf '%s' "$META" | jq -r '.boundary_ts // ""')
USER_TEXT=$(printf '%s'   "$META" | jq -r '.user_text   // ""')

# Walk every text-bearing assistant entry in the current turn, emit
# one journal row per kaomoji-led entry. Each entry maps to ONE
# message the model wrote — Claude Code persists each content block
# as its own top-level transcript JSONL entry, so the natural
# granularity for capture is "one row per text-bearing entry that
# leads with a kaomoji."
#
# When the payload's final message isn't in the transcript yet, it's
# appended as one more row: no transcript timestamp yet (the
# journal-write partial stamps fire time) and the model of the latest
# main-thread assistant entry.
#
# "In the transcript" is judged against the turn's LAST assistant
# message only — the run of assistant entries after the turn's last
# user-type entry (a message's blocks are written back to back; the
# next message only follows a tool_result) — and only if that message
# has no ``tool_use`` block: a message that calls a tool can't be the
# reply that ended the turn, so it means the final one hasn't been
# written. Then the final message is present when its trimmed text
# starts with that message's first text block, which also covers a
# reply the transcript split across several blocks.
# Matching against any earlier message instead would let an earlier
# "(◕‿◕) Done." hide a missing "(◕‿◕) Done. Here's what changed."
#
# jq emits one JSON object per row; we read those line-by-line in
# bash and run the validate + journal-write partials per iteration.
# The validate partial is rendered with ``SKIP_ACTION=continue`` so a
# non-kaomoji entry skips its row without aborting the rest of the
# walk.
jq -cs --arg b "$BOUNDARY_TS" --arg last "$LAST_MSG" '
  def trimmed: sub("^\\s+"; "") | sub("\\s+$"; "");
  def first_text: (.message.content // []) | map(select(.type == "text")) | .[0].text // "";
  ($last | trimmed) as $lt
  | [ .[]
      | select(
          (.type == "assistant" or .type == "user")
          and ((.timestamp // "") >= $b)
          and ((.isSidechain // false) | not)
        )
    ] as $slice
  | [ $slice[] | select(.type == "assistant") ] as $turn
  | [ $turn[]
      | select((.message.content // []) | any(.type == "text" and ((.text // "") | length > 0)))
      | { text: first_text, model: (.message.model // ""), ts: (.timestamp // "") }
    ] as $rows
  | ( ($slice | map(.type) | rindex("user")) as $u
      | if $u == null then $slice else $slice[$u + 1:] end ) as $final
  | ([ $final[] | first_text | trimmed | select(. != "") ] | first // "") as $ft
  | ( ($final | length) > 0
      and ([ $final[] | (.message.content // [])[] | select(.type == "tool_use") ] | length) == 0
      and $ft != ""
      and ($lt | startswith($ft)) ) as $present
  | ( map(select(.type == "assistant" and ((.isSidechain // false) | not)))
      | last | .message.model // "" ) as $last_model
  | $rows
    + ( if $lt == "" or $present then []
        else [{text: $last, model: $last_model, ts: ""}]
        end )
  | .[]
' "$TRANSCRIPT" 2>/dev/null | while IFS= read -r row; do
  [ -z "$row" ] && continue
  ASSISTANT_TEXT=$(printf '%s' "$row" | jq -r '.text')
  MODEL=$(printf         '%s' "$row" | jq -r '.model')
  ROW_TS=$(printf        '%s' "$row" | jq -r '.ts')
  ${KAOMOJI_VALIDATE}
  ${JOURNAL_WRITE}
done

exit 0
