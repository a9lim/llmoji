#!/usr/bin/env bash
# Auto-generated by llmoji $LLMOJI_VERSION. DO NOT edit by hand —
# `llmoji install grok` regenerates this file from
# llmoji/_hooks/grok.sh.tmpl. Edits will be lost.
#
# Grok Stop hook: read-only journal logger. NEVER blocks (no stdout,
# exit 0 — Grok reads a JSON reply on stdout as a stop decision).
# Appends one JSONL row PER kaomoji-led agent message in the current
# turn.
#
# ``transcript_path`` is the session's ``updates.jsonl``, the ACP
# update stream. This turn's messages are its ``agent_message_chunk``
# updates whose ``_meta.promptId`` equals the payload's ``promptId``;
# consecutive chunks join into one message, and any other update
# (tool call, thought) ends it. The model comes from the sibling
# ``chat_history.jsonl`` — the payload carries none.
#
# Schema (canonical 6-field journal row):
#   ts             ISO-8601 UTC  the message's first chunk timestamp
#                                (hook fire time if it has none)
#   model          str           latest assistant ``model_id`` in
#                                chat_history.jsonl
#   cwd            str           working directory (Stop payload)
#   kaomoji        str           leading non-letter prefix of an
#                                agent message, ≥2 bytes
#   user_text      str           latest user message before this
#                                turn's messages (what the user typed)
#   assistant_text str           agent message MINUS the leading
#                                kaomoji + surrounding whitespace
#
# Consumed by `llmoji analyze` via llmoji.sources.journal.
set -u

INPUT=$(cat)

# Grok fires a second, observe-only Stop at session teardown
# (``reason`` ``shutdown`` / ``channel_closed``). Only a genuine turn
# end is journaled; the teardown fire would repeat the last turn.
REASON=$(printf '%s' "$INPUT"    | jq -r '.reason          // empty' 2>/dev/null || true)
[ "$REASON" != "end_turn" ] && exit 0
SUBAGENT=$(printf '%s' "$INPUT"  | jq -r '.subagentType    // empty' 2>/dev/null || true)
[ -n "$SUBAGENT" ] && exit 0

UPDATES=$(printf '%s' "$INPUT"   | jq -r '.transcript_path // .transcriptPath // empty' 2>/dev/null || true)
PROMPT_ID=$(printf '%s' "$INPUT" | jq -r '.promptId        // empty' 2>/dev/null || true)
CWD=$(printf '%s' "$INPUT"       | jq -r '.cwd             // empty' 2>/dev/null || true)

[ -z "$UPDATES" ] && exit 0
[ ! -f "$UPDATES" ] && exit 0
[ -z "$PROMPT_ID" ] && exit 0

CHAT="$(dirname "$UPDATES")/chat_history.jsonl"
MODEL=""
if [ -f "$CHAT" ]; then
  MODEL=$(jq -rs '
    map(select(.type == "assistant" and ((.model_id // "") != "")))
    | last | .model_id // ""
  ' "$CHAT" 2>/dev/null || true)
fi

# One pass over updates.jsonl folds every update into
# ``{msgs, user}``: ``msgs`` collects this turn's messages as
# ``{text, ts}``, ``user`` tracks the latest user message seen before
# the turn's first chunk (consecutive ``user_message_chunk`` updates
# join, like agent chunks). Each emitted row is one message.
jq -cs --arg pid "$PROMPT_ID" '
  def flush: if .cur != null then .msgs += [.cur] | .cur = null else . end;
  ( map(.params // {}
        | (.update // {}) as $u
        | { kind: ($u.sessionUpdate // ""),
            text: (if (($u.content // null) | type) == "object"
                   then ($u.content.text // "") else "" end),
            pid:  (._meta.promptId // ""),
            ts:   ((._meta.agentTimestampMs // null) as $ms
                   | if $ms == null then "" else ($ms / 1000 | floor | todate) end) })
    | reduce .[] as $e (
        {msgs: [], cur: null, user: "", ucur: null, seen: false};
        if $e.kind == "agent_message_chunk" and $e.pid == $pid then
          .seen = true
          | if .cur == null then .cur = {text: $e.text, ts: $e.ts}
            else .cur.text += $e.text end
        elif $e.kind == "user_message_chunk" and (.seen | not) then
          flush
          | if .ucur == null then .ucur = $e.text else .ucur += $e.text end
          | .user = .ucur
        else
          flush | .ucur = null
        end)
    | flush ) as $acc
  | $acc.msgs[]
  | select(.text != "")
  | {text, ts, user: $acc.user}
' "$UPDATES" 2>/dev/null | while IFS= read -r row; do
  [ -z "$row" ] && continue
  ASSISTANT_TEXT=$(printf '%s' "$row" | jq -r '.text')
  ROW_TS=$(printf         '%s' "$row" | jq -r '.ts')
  USER_TEXT=$(printf      '%s' "$row" | jq -r '.user')
  ${KAOMOJI_VALIDATE}
  ${JOURNAL_WRITE}
done

exit 0
