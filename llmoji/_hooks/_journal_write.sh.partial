# Shared journal-write tail. Substituted into every provider's main
# hook by ``HookInstaller.render_hook``.
#
# Inputs (all set by the per-provider header above):
#   $ASSISTANT_TEXT  the assistant message body
#   $KAOMOJI         the validated leading prefix (post-validate partial)
#   $USER_TEXT       latest real user message, system-injection filtered
#   $MODEL           active model slug
#   $CWD             working directory at hook fire
#   $ROW_TS          (optional) the message's own timestamp, ISO-8601
#                    UTC, when the transcript carries one. Unset or
#                    empty falls back to hook fire time. Providers that
#                    can stamp the message time do, so the live row is
#                    byte-identical to the one ``llmoji import`` builds
#                    from the same transcript and the import dedup
#                    folds them instead of counting the message twice.
#   JOURNAL_PATH     rendered absolute path to the journal JSONL
#                    (Python ``string.Template`` substitution; written
#                    as a plain word here, not a shell variable
#                    reference, so the substitution doesn't reach
#                    into this comment)
#
# Writes one canonical 6-field row. ``assistant_text`` has the leading
# kaomoji + surrounding whitespace stripped via jq's
# ``sub("^\\s+";"") | ltrimstr($kaomoji) | sub("^\\s+";"")`` so the
# row contract holds: kaomoji lives in its own field, body is body.
#
# The on-the-way-out strip here is paired with an on-the-way-in
# re-extraction in ``llmoji.sources.journal.iter_journal``, which
# routes through ``llmoji.sources._common.kaomoji_lead_strip``. That
# read-side belt-and-suspenders catches journals authored by
# generic-JSONL contributors who don't run this hook — the bash
# strip + the Python re-strip together guarantee `assistant_text`
# never carries the leading kaomoji regardless of source.
JOURNAL="$JOURNAL_PATH"
mkdir -p "$(dirname "$JOURNAL")"

# A Stop hook fires again when another hook blocks the stop and the
# agent keeps going; the walk then re-emits the turn's earlier
# messages. With rows stamped by message time, such a row is
# byte-identical to the one the earlier fire wrote. So each row is
# checked against the journal's last 256 lines as they stood when this
# run began, and a match uses that line up: each line absorbs one
# identical row, the rest land. Two identical rows from one run (Hermes
# stamps them all with the same fire time) therefore both land, and a
# repeat past an earlier copy lands once. Re-fires follow a blocked
# stop within seconds; the 256-line bound only misses one that comes
# after a turn (or busy concurrent sessions) wrote more rows than that.
if [ -z "${JOURNAL_TAIL_READ:-}" ]; then
  JOURNAL_TAIL=$(tail -n 256 "$JOURNAL" 2>/dev/null || true)
  JOURNAL_TAIL_READ=1
fi

LINE=$(jq -nc \
  --arg ts             "${ROW_TS:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" \
  --arg model          "$MODEL" \
  --arg cwd            "$CWD" \
  --arg kaomoji        "$KAOMOJI" \
  --arg user_text      "$USER_TEXT" \
  --arg assistant_text "$ASSISTANT_TEXT" \
  '{
    ts:             $ts,
    model:          $model,
    cwd:            $cwd,
    kaomoji:        $kaomoji,
    user_text:      $user_text,
    assistant_text: ($assistant_text
                     | sub("^\\s+"; "")
                     | ltrimstr($kaomoji)
                     | sub("^\\s+"; ""))
  }' 2>/dev/null || true)
if [ -n "$LINE" ]; then
  if [ -n "$JOURNAL_TAIL" ] && printf '%s\n' "$JOURNAL_TAIL" | grep -qxF -- "$LINE"; then
    # Use the matched line up (first occurrence only). ENVIRON, not
    # ``awk -v``, so awk doesn't interpret the JSON's backslashes.
    JOURNAL_TAIL=$(printf '%s\n' "$JOURNAL_TAIL" \
      | LLMOJI_LINE="$LINE" awk '!used && $0 == ENVIRON["LLMOJI_LINE"] { used = 1; next } { print }')
  else
    printf '%s\n' "$LINE" >> "$JOURNAL" 2>/dev/null || true
  fi
fi
