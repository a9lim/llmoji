#!/usr/bin/env bash
# Auto-generated by llmoji $LLMOJI_VERSION. DO NOT edit by hand —
# `llmoji install antigravity` regenerates this file from
# llmoji/_hooks/antigravity.sh.tmpl. Edits will be lost.
#
# Antigravity Stop hook: read-only journal logger. NEVER blocks.
# Antigravity reads a JSON object on stdout; ``{}`` carries no
# ``decision``, which lets the agent stop. It's printed first, and
# nothing below writes to stdout.
#
# Appends one JSONL row PER kaomoji-led model message in the current
# turn: every ``PLANNER_RESPONSE`` step with non-empty ``content``
# after the transcript's latest ``USER_INPUT`` step.
#
# Schema (canonical 6-field journal row):
#   ts             ISO-8601 UTC  the step's ``created_at`` (hook fire
#                                time if it has none)
#   model          str           ``modelName`` from the payload
#   cwd            str           first of the payload's
#                                ``workspacePaths``
#   kaomoji        str           leading non-letter prefix of a model
#                                message, ≥2 bytes
#   user_text      str           ``lastUserInput`` (agy 1.4.7+), else
#                                the latest USER_INPUT step with its
#                                ``<USER_REQUEST>`` wrapper removed
#   assistant_text str           model message MINUS the leading
#                                kaomoji + surrounding whitespace
#
# Consumed by `llmoji analyze` via llmoji.sources.journal.
set -u

printf '{}\n'

INPUT=$(cat)

TRANSCRIPT=$(printf '%s' "$INPUT" | jq -r '.transcriptPath          // empty' 2>/dev/null || true)
MODEL=$(printf '%s' "$INPUT"      | jq -r '.modelName               // empty' 2>/dev/null || true)
CWD=$(printf '%s' "$INPUT"        | jq -r '(.workspacePaths // [])[0] // empty' 2>/dev/null || true)
USER_TEXT=$(printf '%s' "$INPUT"  | jq -r '.lastUserInput           // empty' 2>/dev/null || true)

[ -z "$TRANSCRIPT" ] && exit 0
[ ! -f "$TRANSCRIPT" ] && exit 0

# One slurp: slice from the latest USER_INPUT step, emit each model
# message with its step time, and recover the prompt from the step
# itself when the payload predates ``lastUserInput``.
jq -cs --arg user "$USER_TEXT" '
  ([to_entries[] | select(.value.type == "USER_INPUT") | .key] | last // 0) as $s
  | ( if $user != "" then $user
      else ( .[$s].content // ""
             | if type == "string" then . else "" end
             | (capture("<USER_REQUEST>\\n?(?<u>[\\s\\S]*?)\\n?</USER_REQUEST>").u // .) )
      end ) as $u
  | .[$s:][]
  | select(.type == "PLANNER_RESPONSE"
           and ((.content // null) | type) == "string"
           and .content != "")
  | {text: .content, ts: (.created_at // ""), user: $u}
' "$TRANSCRIPT" 2>/dev/null | while IFS= read -r row; do
  [ -z "$row" ] && continue
  ASSISTANT_TEXT=$(printf '%s' "$row" | jq -r '.text')
  ROW_TS=$(printf         '%s' "$row" | jq -r '.ts')
  USER_TEXT=$(printf      '%s' "$row" | jq -r '.user')
  ${KAOMOJI_VALIDATE}
  ${JOURNAL_WRITE}
done

exit 0
