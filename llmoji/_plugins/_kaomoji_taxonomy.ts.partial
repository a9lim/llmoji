// Mirror of llmoji.taxonomy.KAOMOJI_START_CHARS — the literal Python
// frozenset, character for character. These are Unicode glyphs, not
// ASCII. Keep in sync with taxonomy.py.
//
// v2.0 broadened the leader set across five sweep rounds:
//   Round 1 — wing/hug/sparkle (\, ⊂, ✧).
//   Round 2 — Greek (Σ ψ Ψ ε), Latin extensions (ƪ ʕ — raised hands
//     and the bear face), box-drawing diagonals (╱ ╲).
//   Round 3 — pose pairs and shrug components landed in the
//     arm-strip sets (Python-side _ARM_OUTSIDE / _ARM_OUTSIDE_LEAD)
//     rather than the leader set, since the leaders involved (╰ ╭ ╮
//     ┐ ┌ ¯ ＼) were already in v1.
//   Round 4 — Japanese corner brackets (「『【〈《), box-drawing
//     standing-pose corners (└ ┘), music notes (♪ ♫ ♬), hearts
//     (♥ ♡ ❤), stars (★ ☆), and the alternate bear-bracket open
//     ʢ (paired with ʡ).
//   Round 5 — exhaustive sweep for remaining real leaders: flower
//     decorators (✿ ❀), heart variants (❣ ❥), star variants
//     (✦ ✩ ✪), quarter note (♩), flex / strong-feel pose lead
//     arms (ᕦ ᕙ — Canadian Syllabics), tortoise-shell open
//     bracket (〔, paired with 〕), reference mark (※), Oriya
//     cradle pose left arm (୧).
const KAOMOJI_START_CHARS = new Set<string>(
  Array.from("([（｛ヽヾっ٩ᕕ╰╭╮┐┌＼¯໒\\⊂✧ΣψεƪʕΨ╱╲「『【〈《└┘♪♫♬♥♡❤★☆ʢ✿❀❣❥✦✩✪♩ᕦᕙ〔※୧"),
);

// Bracket pairs the depth-walker treats as kaomoji boundaries.
// `ʕ`/`ʔ` recognize the bear face `ʕ•ᴥ•ʔ` as a balanced span;
// `ʢ`/`ʡ` recognize the alternate-bear variants `ʢ◉ᴥ◉ʡ`. The
// Japanese corner-bracket pairs `「『【〈《` / `」』】〉》` let
// corner-wrapped faces (`「(゜～゜)」`, `『(◕‿◕)』`) surface
// directly via the depth walker instead of falling through to the
// whitespace fallback. Round-5 adds the tortoise-shell editorial
// pair `〔`/`〕` (`〔(◕‿◕)〕`, `〔・_・〕` standalone).
const OPEN_BRACKETS = "([（｛ʕʢ「『【〈《〔";
const CLOSE_BRACKETS = ")]）｝ʔʡ」』】〉》〕";
const KAOMOJI_MAX_LEN = 32;
const LETTER_RUN_RE = /[A-Za-z]{4}/;

// JS string indexing returns UTF-16 code units, which splits non-BMP
// glyphs in half. Array.from(str) iterates code points, matching the
// Python str semantics the validator was written against.
function codepoints(s: string): string[] {
  return Array.from(s);
}

// Bare-kaomoji mouth-glyph regex (round-6 + round-7 + round-9 Path B).
// Mirrors llmoji.taxonomy._BARE_KAOMOJI_MOUTH_RE. Round-7 added `ω`
// (Greek omega — the canonical "cute / cat mouth"), `oOwW` (ASCII
// letter mouths for `^o^`, `OwO`, `\o/`, etc.). Round-9 added `ヮ`
// (KATAKANA SMALL WA — the cute-mouth katakana counterpart to `ω`,
// closing the bare-form gap for `^ヮ^` etc.) and `〜` (WAVE DASH,
// U+301C — wavy-mouth glyph; the Python-side typo-sub fold `〜→~`
// canonicalizes both forms, but Path B validation runs before
// canonicalization, so the raw glyph has to live in the bare-mouth
// class too).
const BARE_KAOMOJI_MOUTH_RE = /^[_\-.;:~=^|/\\oOwW·•°ωヮ〜‐-―‥…′-‷‿⁀、。　・ー･＿？︰-﹏▰-◿]+$/u;

// Visually-paired eye glyphs for non-symmetric bare kaomoji like
// `>_<`, `)_(`, `]_[`. Round-7 added the slash pair (`\_/`, `\o/`)
// and the case-mismatch pair (`o_O`, `O_o`).
const BARE_KAOMOJI_PAIRED_EYES: ReadonlySet<string> = new Set([
  "><", "<>", ")(", "()", "][", "[]", "}{", "{}",
  "\\/", "/\\",
  "oO", "Oo",
]);

// Western emoticon eyes (round-7 expansion). The base set is `:;=8`;
// round 7 adds `<>` so `<3` parses as 2-char Western (heart) and so
// the eyebrow-prefix branch can recognize `>` and `<` as standalone
// eyes that COULD start a Western face.
const WESTERN_EYES = ":;=8<>";
const WESTERN_MOUTHS = ")(DPpOo3<>/\\|*[]";
const WESTERN_NOSES = "-^o'";

// Round-7 helper: standard Western emoticon shape. Lifted out of
// looksLikeBareKaomoji so the new eyebrow-prefix branch and the
// cat-wrap recursion can reuse it. Rejects same-char-as-eye mouth
// runs (`>>`, `<<`, `==`) — these structurally pass because `>`,
// `<`, `=` are in both eye and mouth sets but aren't real faces.
function isWesternEmoticon(s: string): boolean {
  const chars = codepoints(s);
  const n = chars.length;
  if (!(n >= 2 && n <= 4)) return false;
  if (!WESTERN_EYES.includes(chars[0])) return false;
  let rest = chars.slice(1);
  if (rest.length > 0 && WESTERN_NOSES.includes(rest[0])) {
    rest = rest.slice(1);
  }
  if (rest.length === 0 || !rest.every((c) => WESTERN_MOUTHS.includes(c))) {
    return false;
  }
  if (rest.every((c) => c === chars[0])) return false;
  return true;
}

// Round-7 Korean closed-eye doubles (crying).
const KOREAN_CLOSED_EYE_DOUBLES: ReadonlySet<string> = new Set(["ㅠㅠ", "ㅜㅜ"]);

// Round-7 explicit-allow set for the canonical anime/uwu shapes
// (`OwO`, `UwU`, etc.). All-ASCII-alpha shapes that would otherwise
// reject under the all-alpha guard in the symmetric branch.
const UWU_FACES: ReadonlySet<string> = new Set([
  "OwO", "OWO", "owo",
  "UwU", "UWU", "uwu",
  "OvO", "OVO", "ovo",
  "UvU", "UVU", "uvu",
]);

// Port of llmoji.taxonomy._looks_like_bare_kaomoji. Six shape
// branches: symmetric / paired EYE-MOUTH-EYE, standard Western,
// eyebrow-prefix Western (round-7), cat-wrap `=...=` (round-7),
// 2-char closed-eye doubles (incl. round-7 Korean ㅠㅠ/ㅜㅜ), and
// 2-char laugh `[xX][DPpOo3]`.
function looksLikeBareKaomoji(s: string): boolean {
  const chars = codepoints(s);
  const n = chars.length;
  if (n < 2) return false;

  // 2-char patterns.
  if (n === 2) {
    if (chars[0] === chars[1] && "^vu".includes(chars[0])) return true;
    if (KOREAN_CLOSED_EYE_DOUBLES.has(s)) return true;
    // XD-family: `[xX][DPpOo3]` — round-7 generalizes XD/xD to also
    // accept XP/x3/Xp/etc.
    if ("xX".includes(chars[0]) && "DPpOo3".includes(chars[1])) return true;
    // 2-char Western. Reject same-char (`>>`, `<<`, `==`) — these
    // pass structurally but aren't real faces.
    if (
      WESTERN_EYES.includes(chars[0]) &&
      WESTERN_MOUTHS.includes(chars[1]) &&
      chars[0] !== chars[1]
    ) {
      return true;
    }
    return false;
  }

  // Round-7 cat-wrap: `=EYE-MOUTH-EYE=`. Recurses one level.
  if (n >= 5 && chars[0] === "=" && chars[n - 1] === "=") {
    if (looksLikeBareKaomoji(chars.slice(1, -1).join(""))) return true;
  }

  // Standard Western (3-4 chars).
  if (isWesternEmoticon(s)) return true;

  // Round-7 eyebrow-prefix Western: `>` or `<` prefix on a standard
  // Western emoticon (e.g. `>:(`, `>:D`, `<:(`).
  if (n >= 3 && "><".includes(chars[0]) && isWesternEmoticon(chars.slice(1).join(""))) {
    return true;
  }

  // Round-7 explicit anime/uwu shapes (`OwO`, `UwU`, etc.) —
  // all-alpha but kaomoji-coded. Allowed before the all-alpha guard
  // below so they don't get rejected.
  if (UWU_FACES.has(s)) return true;

  // Symmetric / paired-eye EYE-MOUTH-EYE.
  const interior = chars.slice(1, -1).join("");
  if (!interior) return false;
  if (!BARE_KAOMOJI_MOUTH_RE.test(interior)) return false;
  const first = chars[0];
  const last = chars[n - 1];
  // First must not appear in interior (rejects pure-mouth sequences
  // without distinct eyes: `___`, `...`, `---`).
  if (interior.includes(first)) return false;
  // All-ASCII-alpha guard: rejects 3-letter palindromes (`lol`,
  // `mom`, `awa`). Mixed-script (`OωO`, `ಥ﹏ಥ`) and any string with
  // a non-letter char passes through.
  if (/^[A-Za-z]+$/.test(s)) return false;
  if (first === last) return true;
  if (BARE_KAOMOJI_PAIRED_EYES.has(first + last)) return true;
  return false;
}

// Round-7 content-bearing check (Path-A tightener). Rejects bracket-
// letter-only spans like `[a]`, `(b)`, `(test)` that pass the leader
// check on shape alone but contain no kaomoji-coded glyphs. Path B
// has its own structural rules and bypasses this check.
function hasKaomojiContent(s: string): boolean {
  for (const c of codepoints(s)) {
    if (c.charCodeAt(0) > 127) return true;  // non-ASCII
    if (/[A-Za-z]/.test(c)) continue;
    if (OPEN_BRACKETS.includes(c) || CLOSE_BRACKETS.includes(c)) continue;
    return true;
  }
  return false;
}

// Port of llmoji.taxonomy.is_kaomoji_candidate. Rules:
//   Universal (all must pass):
//     - length 2..KAOMOJI_MAX_LEN
//     - no ASCII backslash AT POSITION >= 1 (markdown-escape artifact);
//       position 0 is allowed (wing-hand `\(^o^)/` pattern, v2.0)
//     - no run of 4+ consecutive ASCII letters (prose)
//   Path A (existing leader-char path):
//     - first char in KAOMOJI_START_CHARS
//   Path B (round-6 bare-kaomoji extension):
//     - matches looksLikeBareKaomoji shape
function isKaomojiCandidate(s: string): boolean {
  const chars = codepoints(s);
  if (chars.length < 2 || chars.length > KAOMOJI_MAX_LEN) return false;
  if (chars.slice(1).includes("\\")) return false;
  if (LETTER_RUN_RE.test(s)) return false;
  // Path A: leader char + content-bearing.
  if (KAOMOJI_START_CHARS.has(chars[0]) && hasKaomojiContent(s)) return true;
  if (looksLikeBareKaomoji(s)) return true;
  return false;
}

// Port of llmoji.taxonomy._leading_bracket_span. If the lstripped
// text starts with an OPEN_BRACKETS char, scan forward depth-counting
// until the matching close paren — bounded by KAOMOJI_MAX_LEN so
// balanced-paren prose can't slurp the whole sentence. Otherwise
// take the leading whitespace-delimited word (also capped at
// KAOMOJI_MAX_LEN). Run isKaomojiCandidate; return "" if it fails.
function leadingBracketSpan(text: string): string {
  const stripped = text.replace(/^\s+/, "");
  if (!stripped) return "";
  const chars = codepoints(stripped);
  let candidate = "";
  if (OPEN_BRACKETS.includes(chars[0])) {
    let depth = 0;
    for (let i = 0; i < chars.length; i++) {
      const c = chars[i];
      if (OPEN_BRACKETS.includes(c)) {
        depth += 1;
      } else if (CLOSE_BRACKETS.includes(c)) {
        depth -= 1;
        if (depth === 0) {
          candidate = chars.slice(0, i + 1).join("");
          break;
        }
        if (depth < 0) break;
      }
      if (i + 1 >= KAOMOJI_MAX_LEN) break;
    }
  } else {
    let idx = 0;
    while (idx < chars.length && !/\s/.test(chars[idx])) {
      idx += 1;
      if (idx >= KAOMOJI_MAX_LEN) break;
    }
    candidate = chars.slice(0, idx).join("");
  }
  if (candidate && isKaomojiCandidate(candidate)) return candidate;
  return "";
}
